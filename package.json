{
  "name": "neordinary-hackathon-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "app:sync": "npm run build && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
